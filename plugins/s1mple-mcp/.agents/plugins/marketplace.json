{
  "name": "s1mple-mcp",
  "version": "1.4.0",
  "interface": {
    "displayName": "s1mple MCP",
    "logo": "../../assets/logo.svg",
    "defaultPrompt": [
      "使用 s1mple-session 驗證我的 MCP 設定。確認可用後，簡短說明一下你能幫我做什麼。",
      "使用 s1mple-contacts 列出最近聯絡人。",
      "使用 s1mple-ops 給我一份專案摘要。"
    ]
  },
  "plugins": [
    {
      "name": "s1mple-mcp",
      "version": "1.4.0",
      "source": {
        "source": "local",
        "path": "./s1mple-mcp"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
